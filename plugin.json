{
  "workflow": {
    "nodes": [
      {
        "id": "plugin-metadata",
        "type": "modifier",
        "position": {
          "x": 240,
          "y": 160
        },
        "data": {
          "modifier": {
            "name": "Grain Segmentation",
            "key": "grain-segmentation",
            "icon": "HiCube",
            "author": "Rodolfo Herrera",
            "license": "MIT",
            "version": "1.0.3",
            "homepage": "https://github.com/rodyherrera/Volterra",
            "description": "Segmenta granos cristalinos a partir de PTM local, mergeando orientaciones similares."
          }
        }
      },
      {
        "id": "plugin-arguments",
        "type": "arguments",
        "position": {
          "x": 528,
          "y": 208
        },
        "data": {
          "arguments": {
            "arguments": [
              {
                "argument": "rmsd",
                "type": "number",
                "label": "RMSD",
                "default": 0.1,
                "min": 0,
                "step": 0.01
              },
              {
                "argument": "minGrainAtomCount",
                "type": "number",
                "label": "Min Grain Atom Count",
                "default": 100,
                "min": 1,
                "step": 1
              },
              {
                "argument": "adoptOrphanAtoms",
                "type": "select",
                "label": "Adopt Orphan Atoms",
                "default": "true",
                "options": [
                  {
                    "key": "true",
                    "label": "True"
                  },
                  {
                    "key": "false",
                    "label": "False"
                  }
                ]
              },
              {
                "argument": "handleCoherentInterfaces",
                "type": "select",
                "label": "Handle Coherent Interfaces",
                "default": "true",
                "options": [
                  {
                    "key": "true",
                    "label": "True"
                  },
                  {
                    "key": "false",
                    "label": "False"
                  }
                ]
              },
              {
                "argument": "outputBonds",
                "type": "boolean",
                "label": "Output Bonds",
                "default": false
              }
            ]
          }
        }
      },
      {
        "id": "trajectory-context",
        "type": "context",
        "position": {
          "x": 816,
          "y": 160
        },
        "data": {
          "context": {
            "source": "trajectory_dumps"
          }
        }
      },
      {
        "id": "foreach-trajectory-dumps",
        "type": "forEach",
        "position": {
          "x": 1088,
          "y": 208
        },
        "data": {
          "forEach": {
            "iterableSource": "{{ trajectory-context.trajectory_dumps }}"
          }
        }
      },
      {
        "id": "analysis-entrypoint",
        "type": "entrypoint",
        "position": {
          "x": 1392,
          "y": 208
        },
        "data": {
          "entrypoint": {
            "type": "executable",
            "binary": "grain-segmentation",
            "binaryObjectPath": "__UPLOAD_BINARY_OBJECT_PATH__",
            "binaryFileName": "grain-segmentation",
            "arguments": "{{ foreach-trajectory-dumps.currentValue.path }} {{ foreach-trajectory-dumps.outputPath }} {{ plugin-arguments.as_str }}",
            "timeout": -1
          }
        }
      },
      {
        "id": "primary-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 208
        },
        "data": {
          "exposure": {
            "name": "Grain Segmentation",
            "icon": "HiCube",
            "results": "grains.parquet",
            "iterable": ""
          }
        }
      },
      {
        "id": "grain-model-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 344
        },
        "data": {
          "exposure": {
            "name": "Grain Model",
            "icon": "HiCube",
            "results": "atoms.parquet",
            "iterable": ""
          }
        }
      },
      {
        "id": "grain-model-export",
        "type": "export",
        "position": {
          "x": 2032,
          "y": 344
        },
        "data": {
          "export": {
            "exporter": "AtomisticExporter",
            "type": "glb"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "edge-metadata-arguments",
        "source": "plugin-metadata",
        "sourceHandle": "output",
        "target": "plugin-arguments",
        "targetHandle": "input"
      },
      {
        "id": "edge-arguments-context",
        "source": "plugin-arguments",
        "sourceHandle": "output",
        "target": "trajectory-context",
        "targetHandle": "input"
      },
      {
        "id": "edge-context-foreach",
        "source": "trajectory-context",
        "sourceHandle": "output",
        "target": "foreach-trajectory-dumps",
        "targetHandle": "input"
      },
      {
        "id": "edge-foreach-entrypoint",
        "source": "foreach-trajectory-dumps",
        "sourceHandle": "output",
        "target": "analysis-entrypoint",
        "targetHandle": "input"
      },
      {
        "id": "edge-entrypoint-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "primary-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-entrypoint-grain-model-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "grain-model-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-grain-model-exposure-grain-model-export",
        "source": "grain-model-exposure",
        "sourceHandle": "output",
        "target": "grain-model-export",
        "targetHandle": "input"
      }
    ]
  }
}
