{
  "workflow": {
    "nodes": [
      {
        "id": "plugin-metadata",
        "type": "modifier",
        "position": {
          "x": 240,
          "y": 160
        },
        "data": {
          "modifier": {
            "name": "Grain Segmentation",
            "key": "grain-segmentation",
            "icon": "HiCube",
            "author": "Rodolfo Herrera",
            "license": "MIT",
            "version": "2.0.3",
            "homepage": "https://github.com/rodyherrera/Volterra",
            "description": "Segmenta granos cristalinos a partir de PTM local, mergeando orientaciones similares."
          }
        }
      },
      {
        "id": "trajectory-context",
        "type": "context",
        "position": {
          "x": 816,
          "y": 160
        },
        "data": {
          "context": {
            "source": "trajectory_dumps"
          }
        }
      },
      {
        "id": "foreach-trajectory-dumps",
        "type": "forEach",
        "position": {
          "x": 1088,
          "y": 208
        },
        "data": {
          "forEach": {
            "iterableSource": "{{ trajectory-context.trajectory_dumps }}"
          }
        }
      },
      {
        "id": "analysis-entrypoint",
        "type": "entrypoint",
        "position": {
          "x": 1392,
          "y": 208
        },
        "data": {
          "entrypoint": {
            "type": "executable",
            "binary": "grain-segmentation",
            "binaryObjectPath": "__UPLOAD_BINARY_OBJECT_PATH__",
            "binaryFileName": "grain-segmentation",
            "arguments": "{{ foreach-trajectory-dumps.currentValue.path }} {{ foreach-trajectory-dumps.outputPath }}",
            "timeout": -1
          }
        }
      },
      {
        "id": "primary-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 208
        },
        "data": {
          "exposure": {
            "name": "Grain Segmentation",
            "icon": "HiCube",
            "results": "grains.parquet",
            "iterable": ""
          }
        }
      },
      {
        "id": "grain-model-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 344
        },
        "data": {
          "exposure": {
            "name": "Grain Model",
            "icon": "HiCube",
            "results": "atoms.parquet",
            "iterable": ""
          }
        }
      },
      {
        "id": "grain-model-export",
        "type": "export",
        "position": {
          "x": 2032,
          "y": 344
        },
        "data": {
          "export": {
            "exporter": "AtomisticExporter",
            "type": "glb"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "edge-context-foreach",
        "source": "trajectory-context",
        "sourceHandle": "output",
        "target": "foreach-trajectory-dumps",
        "targetHandle": "input"
      },
      {
        "id": "edge-foreach-entrypoint",
        "source": "foreach-trajectory-dumps",
        "sourceHandle": "output",
        "target": "analysis-entrypoint",
        "targetHandle": "input"
      },
      {
        "id": "edge-entrypoint-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "primary-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-entrypoint-grain-model-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "grain-model-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-grain-model-exposure-grain-model-export",
        "source": "grain-model-exposure",
        "sourceHandle": "output",
        "target": "grain-model-export",
        "targetHandle": "input"
      },
      {
        "id": "edge-plugin-metadata-trajectory-context",
        "source": "plugin-metadata",
        "sourceHandle": "output",
        "target": "trajectory-context",
        "targetHandle": "input"
      }
    ]
  },
  "interface": {
    "version": 2,
    "provides": {
      "volt/grain-segmentation@1": {
        "grains": "grains.parquet",
        "grain_atoms": "atoms.parquet"
      },
      "volt/per-atom-properties@1": {
        "atoms": "atoms.parquet"
      }
    }
  }
}
